# ==============================================================================
# Personal Finance App - Production Security & Protection
# ==============================================================================

# 1. Disable Directory Browsing
Options -Indexes -MultiViews

# 2. Block Direct HTTP Download of Sensitive File Types
<FilesMatch "(config\.json|\.(db|sqlite|sqlite3|sql|bak|log|ini|env|sh|conf|csv|md|xlsx?))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Prevent Access to Hidden / Dot Files (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Protect Internal Source Classes & Views from Direct Execution
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to views and src backend files
    RewriteRule ^(views|src)/.*$ - [F,L]
</IfModule>

# 5. Production Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
